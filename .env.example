# Core services
OLLAMA_BASE_URL=http://ollama:11434
CATALOG_API_URL=http://api:8424

# AI provider for orchestrator parser
AI_BASE_URL=https://polza.ai/api/v1
AI_MODEL=openai/gpt-4o

# Orchestrator memory (Redis)
REDIS_URL=redis://redis:6379/0
MEMORY_TTL_SEC=86400
MEMORY_MAX_TURNS=8
MEMORY_PREFIX=mem

# Bitrix adapter
ORCHESTRATOR_URL=http://orchestrator:8430
DEFAULT_COLLECTION_NAME=CHINT
DEFAULT_TENANT_ID=default

# Bitrix24 credentials/settings
# Example: https://your-domain.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx
BITRIX_WEBHOOK_URL=
BITRIX_BOT_ID=
BITRIX_CLIENT_ID=
BITRIX_WEBHOOK_VERIFY_TOKEN=
