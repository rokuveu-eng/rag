
# Core services
OLLAMA_BASE_URL=http://ollama:11434
QDRANT_HOST=qdrant
QDRANT_PORT=6333
CATALOG_API_URL=http://api:8424

# AI provider for orchestrator parser
# AI settings
# For OpenAI-compatible endpoints (recommended for Orchestrator), include `/v1` in the base URL
# Example for local Ollama running OpenAI-compatible API: http://ollama:11434/v1
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=qwen3.5:9b
# Optional API key for OpenAI-compatible endpoints (leave empty for local Ollama without auth)
AI_API_KEY=

# Orchestrator memory (Redis)
REDIS_URL=redis://redis:6379/0
MEMORY_TTL_SEC=86400
MEMORY_MAX_TURNS=8
MEMORY_PREFIX=mem

# API settings
API_HOST=0.0.0.0
API_PORT=8424
SPEC_DIR=/app/specs

# Bitrix incoming webhook (optional). Example: https://your.bitrix24.ru/rest/1/XXXXXXXX
# The webhook must have scopes to read Disk files/folders: `disk` (or specifically
# `disk.read` / `disk.file.get` / `disk.folder.getchildren`) depending on your Bitrix setup.
BITRIX_WEBHOOK_URL=

# Notes:
# - `QDRANT_HOST` and `QDRANT_PORT` используются в `api/main.py` при подключении к Qdrant.
# - Если вы не используете Redis, оставьте `REDIS_URL` пустым для отключения краткой памяти Orchestrator.
# - Для корректной работы dense-эмбеддингов нужен доступ к Ollama (или замените `OLLAMA_BASE_URL`).

